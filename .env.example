# Home Assistant WebSocket API URL (note the /api/websocket path)
HA_URL=ws://homeassistant.local:8123/api/websocket

# Long-lived access token: HA profile page -> Security -> Long-lived access tokens
HA_TOKEN=paste-your-long-lived-token-here

# Optional: Stream Deck brightness, 0-100 (default 60)
HOMEDECK_BRIGHTNESS=60

# Optional: which weather.* entity feeds the Weather tile (default: first found)
# HOMEDECK_WEATHER_ENTITY=weather.home
