# Home Assistant WebSocket API URL (note the /api/websocket path)
HA_URL=ws://homeassistant.local:8123/api/websocket

# Long-lived access token: HA profile page -> Security -> Long-lived access tokens
HA_TOKEN=paste-your-long-lived-token-here

# Optional: Stream Deck brightness, 0-100 (default 60)
HOMEDECK_BRIGHTNESS=60

# Optional: which weather.* entity feeds the Weather tile (default: first found)
# HOMEDECK_WEATHER_ENTITY=weather.home

# Optional: an occupancy/presence entity the display follows — the deck's backlight
# turns off when it reports "off" (room empty) and back on when it reports "on".
# Unset (default) keeps the display always on.
# HOMEDECK_OCCUPANCY_ENTITY=binary_sensor.office_occupancy

# Optional: timezone for history clock times. HomeDeck uses Home Assistant's own
# timezone when it can read it; this is the fallback (default Europe/Madrid).
# TZ=Europe/Madrid

# Optional: initial display rotation in degrees (0/90/180/270) for portrait/landscape.
# Also changeable at runtime via Settings -> Rotate. The runtime choice persists to
# HOMEDECK_STATE_FILE (default ~/.homedeck/state.json) — mount a volume for it in Docker
# to survive container restarts.
# HOMEDECK_ROTATION=0
# HOMEDECK_STATE_FILE=/data/state.json
