# systemd unit for HomeDeck. Adjust User and paths to your install, then:
#   sudo cp deploy/homedeck.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now homedeck
[Unit]
Description=HomeDeck - Stream Deck XL controller for Home Assistant
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/homedeck
EnvironmentFile=/home/pi/homedeck/.env
ExecStart=/home/pi/homedeck/.venv/bin/python -m homedeck
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
